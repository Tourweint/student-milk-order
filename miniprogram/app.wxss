/* 全局样式 */
page {
  background-color: #f5f7fa;
  font-size: 28rpx;
  color: #303133;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 16rpx;
}

/* 主按钮 */
.btn-primary {
  background: #409eff;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #606266;
  margin-bottom: 10rpx;
}

.form-input {
  background: #ffffff;
  border: 1rpx solid #dcdfe6;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #909399;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* 文本工具 */
.text-muted {
  color: #909399;
}
.text-price {
  color: #f56c6c;
  font-weight: 600;
}
.text-success {
  color: #67c23a;
}
