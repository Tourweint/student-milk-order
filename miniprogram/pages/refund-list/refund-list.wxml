<view class="page">
  <!-- 状态筛选 -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="code"
      class="tab {{activeStatus === item.code ? 'tab-active' : ''}}"
      bindtap="switchTab"
      data-code="{{item.code}}"
    >{{item.label}}</view>
  </view>

  <view class="container" wx:if="{{refunds.length}}">
    <view class="card refund-card" wx:for="{{refunds}}" wx:key="id" bindtap="showDetail" data-index="{{index}}">
      <view class="refund-head">
        <text class="refund-no">{{item.refundNo}}</text>
        <text class="refund-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="refund-body">
        <view class="refund-main">
          <view class="refund-order">订单 {{item.orderNo}}</view>
          <view class="refund-meta">
            <text>申请 {{item.applyBoxCount == null ? '—' : item.applyBoxCount}} 盒</text>
            <text> · 已退 {{item.refundedBoxes || 0}} 盒</text>
          </view>
          <view wx:if="{{item.applyReason}}" class="refund-reason">原因：{{item.applyReason}}</view>
          <view wx:if="{{item.auditRemark}}" class="refund-audit">审核：{{item.auditRemark}}</view>
        </view>
        <view class="refund-amount">
          <text wx:if="{{item.refundAmount != null}}" class="text-price">¥{{item.refundAmount}}</text>
          <text wx:else class="text-muted">待执行</text>
        </view>
      </view>
      <view class="refund-foot">
        <text class="refund-time">申请 {{item.createTime}}</text>
        <text class="refund-time" wx:if="{{item.refundTime}}">退款 {{item.refundTime}}</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{!hasMore}}" class="empty">— 没有更多了 —</view>
  </view>

  <view wx:elif="{{loading}}" class="empty">加载中…</view>
  <view wx:else class="empty">
    <view>暂无{{tabs[activeStatus].label}}退款单</view>
    <view class="empty-action" bindtap="goOrders">去我的订单申请退款 ›</view>
  </view>
</view>
