.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #409eff 0%, #66b1ff 30%, #f5f7fa 30%);
  padding: 0 32rpx 60rpx;
  box-sizing: border-box;
}

.brand {
  text-align: center;
  padding: 100rpx 0 60rpx;
}

.brand-icon {
  font-size: 96rpx;
  line-height: 1;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 20rpx;
}

.brand-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.login-card {
  padding: 40rpx 32rpx;
}

.tip {
  font-size: 24rpx;
  color: #909399;
  text-align: center;
  margin-top: 20rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
}

.search-btn {
  background: #409eff;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 10rpx;
  padding: 0 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  white-space: nowrap;
}

.student-list {
  margin-bottom: 24rpx;
}

.student-item {
  border: 1rpx solid #dcdfe6;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  background: #f8fafc;
}

.student-item.selected {
  border-color: #409eff;
  background: #ecf5ff;
}

.student-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.parent-name {
  font-size: 24rpx;
  font-weight: 400;
  color: #606266;
}

.bind-btn {
  margin-top: 8rpx;
}
