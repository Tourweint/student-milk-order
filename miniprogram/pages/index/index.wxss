.welcome {
  background: linear-gradient(135deg, #409eff 0%, #79bbff 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.welcome-greet {
  font-size: 34rpx;
  font-weight: 700;
}

.welcome-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 剩余待配送 */
.pending-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pending-label {
  font-size: 28rpx;
  color: #606266;
}

.pending-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.pending-main {
  display: flex;
  flex-direction: column;
}

.pending-tip {
  font-size: 22rpx;
  color: #909399;
  margin-top: 4rpx;
}

.pending-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.pending-next {
  font-size: 22rpx;
  color: #409eff;
  margin-top: 4rpx;
}

/* 近期拒收 */
.reject-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.reject-item:last-child {
  border-bottom: none;
}

.reject-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.reject-product {
  font-size: 28rpx;
  color: #1f2d3d;
}

.reject-reason {
  font-size: 22rpx;
  color: #e6a23c;
  margin-top: 4rpx;
}

.reject-date {
  font-size: 22rpx;
  color: #909399;
}

.reject-note {
  font-size: 22rpx;
  color: #909399;
  margin-top: 12rpx;
}

/* 套餐横向滚动 */
.pkg-scroll {
  white-space: nowrap;
}

.pkg-item {
  display: inline-block;
  width: 300rpx;
  background: #f8fafc;
  border: 1rpx solid #ebeef5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.pkg-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
  white-space: normal;
}

.pkg-desc {
  font-size: 22rpx;
  color: #909399;
  margin: 8rpx 0 12rpx;
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  height: 60rpx;
}

.pkg-origin {
  font-size: 22rpx;
  color: #c0c4cc;
  text-decoration: line-through;
  margin-left: 8rpx;
}

/* 奶品列表 */
.product-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.product-meta {
  font-size: 24rpx;
  color: #909399;
  margin: 8rpx 0;
}

.product-stock {
  font-size: 22rpx;
  color: #c0c4cc;
}

.product-right {
  text-align: right;
}

.product-price {
  font-size: 32rpx;
}

.product-buy {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #409eff;
  border: 1rpx solid #409eff;
  border-radius: 8rpx;
  padding: 6rpx 24rpx;
  display: inline-block;
}

/* 卡片标题行（标题 + 购物车入口） */
.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-link {
  font-size: 24rpx;
  color: #409eff;
}

/* 加购按钮（catchtap，不冒泡） */
.product-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.product-add {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #67c23a;
  border: 1rpx solid #67c23a;
  border-radius: 8rpx;
  padding: 6rpx 20rpx;
  display: inline-block;
}

/* 当日豁免卡片：今天还有未送出的奶时才出现（病假/外出临时不要） */
.exempt-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-left: 6rpx solid #e6a23c;
}

.exempt-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.exempt-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.exempt-tip {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.exempt-btn {
  flex-shrink: 0;
  margin: 0;
}
