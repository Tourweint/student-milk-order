<view class="container">
  <!-- 欢迎区 -->
  <view class="welcome">
    <view class="welcome-greet">你好，{{user.realName || user.username || '家长'}}</view>
    <view class="welcome-sub">为孩子挑选健康营养的学生奶</view>
  </view>

  <!-- 剩余待配送 -->
  <view class="card pending-card" wx:if="{{pendingLoaded}}">
    <view class="pending-main">
      <text class="pending-label">剩余待配送</text>
      <text class="pending-tip">{{pendingQuantity > 0 ? '含配送中，不含已取消与拒收' : '已全部送达，或暂无在途订单'}}</text>
    </view>
    <view class="pending-right">
      <text wx:if="{{pendingQuantity > 0}}" class="pending-value">共 <text class="text-price">{{pendingQuantity}}</text> 盒</text>
      <text wx:else class="pending-value">暂无待配送</text>
      <text wx:if="{{nextDeliveryDate}}" class="pending-next">下次配送 {{nextDeliveryDate}}</text>
    </view>
  </view>

  <!-- 当日豁免：今天还有未送出的奶时，家长可临时不要（每月限次，配额回补） -->
  <view class="card exempt-card" wx:if="{{exemption && exemption.exemptableCount > 0}}">
    <view class="exempt-main">
      <text class="exempt-title">今天有 {{exemption.exemptableCount}} 份奶尚未送出</text>
      <text class="exempt-tip">临时不要（病假/外出）可申请当日豁免：取消今天未送出的配送，配额回补给其他孩子；本月剩余 {{exemption.remaining}} 次</text>
    </view>
    <button class="exempt-btn" size="mini" type="warn" bindtap="onExemptToday">当日豁免</button>
  </view>

  <!-- 近期拒收（仅真拒收；退订/缺货取消不会出现在这里） -->
  <view class="card" wx:if="{{recentRejects.length}}">
    <view class="card-title">近期拒收</view>
    <view class="reject-item" wx:for="{{recentRejects}}" wx:key="recordId">
      <view class="reject-main">
        <text class="reject-product">{{item.productName || '奶品'}}</text>
        <text class="reject-reason">{{item.reasonText}}</text>
      </view>
      <text class="reject-date">{{item.deliveryDate}}</text>
    </view>
    <view class="reject-note">拒收的奶已由系统安排次日补送，可在配送记录中查看</view>
  </view>

  <!-- 套餐区 -->
  <view class="card" wx:if="{{packages.length}}">
    <view class="card-title">优惠套餐</view>
    <scroll-view scroll-x class="pkg-scroll" enhanced show-scrollbar="{{false}}">
      <view class="pkg-item" wx:for="{{packages}}" wx:key="id" bindtap="goPackage" data-id="{{item.id}}">
        <view class="pkg-name">{{item.packageName}}</view>
        <view class="pkg-desc">{{item.description || '奶品组合优惠套餐'}}</view>
        <view class="pkg-price">
          <text class="text-price">¥{{item.discountPrice || item.originalPrice}}</text>
          <text wx:if="{{item.originalPrice}}" class="pkg-origin">¥{{item.originalPrice}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 奶品列表 -->
  <view class="card">
    <view class="card-title-row">
      <view class="card-title">奶品选购</view>
      <view class="cart-link" bindtap="goCart">购物车{{cartCount > 0 ? '（' + cartCount + '）' : ''}} ›</view>
    </view>
    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{products.length === 0}}" class="empty">暂无上架奶品</view>
    <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
      <view class="product-info">
        <view class="product-name">{{item.productName}}</view>
        <view class="product-meta">
          <text>{{item.spec}}</text>
          <text wx:if="{{item.flavor}}"> · {{item.flavor}}</text>
          <text> · {{item.categoryName || '奶品'}}</text>
        </view>
      </view>
      <view class="product-right">
        <view class="text-price product-price">¥{{item.price}}</view>
        <view class="product-actions">
          <view class="product-add" catchtap="addCart" data-id="{{item.id}}">＋ 加购</view>
          <view class="product-buy">订奶</view>
        </view>
      </view>
    </view>
  </view>
</view>
