.status-head {
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.status-bg-1 { background: linear-gradient(135deg, #e6a23c, #f3c869); }
.status-bg-2 { background: linear-gradient(135deg, #67c23a, #95d475); }
.status-bg-3 { background: linear-gradient(135deg, #409eff, #79bbff); }
.status-bg-4 { background: linear-gradient(135deg, #909399, #b1b3b8); }
.status-bg-5 { background: linear-gradient(135deg, #c0c4cc, #dcdfe6); }

.status-text {
  font-size: 44rpx;
  font-weight: 700;
}

.status-no {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.row-label {
  color: #909399;
}

.row-value {
  color: #303133;
  text-align: right;
  max-width: 60%;
}

/* 明细 */
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.item-name {
  font-size: 28rpx;
  color: #1f2d3d;
  font-weight: 500;
}

.item-meta {
  font-size: 22rpx;
  color: #909399;
  margin-top: 6rpx;
}

.item-subtotal {
  font-size: 28rpx;
  color: #303133;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.amount-pay {
  border-top: 1rpx dashed #ebeef5;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.desc {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.7;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
}

.btn-ghost {
  background: #ffffff;
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
