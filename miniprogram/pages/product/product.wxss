.hero {
  background: linear-gradient(135deg, #409eff 0%, #79bbff 100%);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
  flex-wrap: wrap;
}

.hero-tag {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.hero-price {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.price-symbol {
  font-size: 28rpx;
}

.price-num {
  font-size: 56rpx;
  font-weight: 700;
}

.price-unit {
  font-size: 24rpx;
  opacity: 0.85;
  margin-left: 4rpx;
}

.hero-stock {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.desc {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.7;
}

/* 底部固定栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #ebeef5;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.footer-btn {
  flex: 1;
  width: auto;
  min-width: 0;
  font-size: 28rpx;
  padding-left: 0;
  padding-right: 0;
}

/* 加入购物车（描边款） */
.btn-cart {
  background: #ffffff;
  color: #409eff;
  border: 1rpx solid #409eff;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 20rpx 0;
  text-align: center;
}

/* 购物车入口 */
.footer-cart {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon {
  font-size: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  background: #f56c6c;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

/* 购买数量 */
.qty-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0f2f5;
  color: #606266;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-btn-active {
  background: #ecf5ff;
  color: #409eff;
}

.stepper-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 页面底部留白，避免被固定栏遮挡 */
.container {
  padding-bottom: 140rpx;
}

.qty-hint {
  font-size: 22rpx;
  color: #909399;
  margin-top: 12rpx;
  line-height: 1.6;
}
