.hero {
  background: linear-gradient(135deg, #409eff 0%, #79bbff 100%);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
  flex-wrap: wrap;
}

.hero-tag {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.hero-price {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.price-symbol {
  font-size: 28rpx;
}

.price-num {
  font-size: 56rpx;
  font-weight: 700;
}

.price-unit {
  font-size: 24rpx;
  opacity: 0.85;
  margin-left: 4rpx;
}

.hero-stock {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.desc {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.7;
}

/* 底部固定栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #ebeef5;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.footer-price {
  font-size: 36rpx;
}

.footer-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
}

.footer-btn {
  width: 320rpx;
}

/* 页面底部留白，避免被固定栏遮挡 */
.container {
  padding-bottom: 140rpx;
}
