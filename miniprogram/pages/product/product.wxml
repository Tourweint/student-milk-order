<view class="container" wx:if="{{product}}">
  <!-- 奶品主图区（暂无图片资源，用渐变占位） -->
  <view class="hero">
    <view class="hero-name">{{product.productName}}</view>
    <view class="hero-tags">
      <text class="hero-tag">{{product.categoryName || '奶品'}}</text>
      <text wx:if="{{product.spec}}" class="hero-tag">{{product.spec}}</text>
      <text wx:if="{{product.flavor}}" class="hero-tag">{{product.flavor}}</text>
    </view>
    <view class="hero-price">
      <text class="price-symbol">¥</text>
      <text class="price-num">{{product.price}}</text>
      <text class="price-unit">/盒</text>
    </view>
    <view class="hero-stock">库存 {{product.quantity}} 盒</view>
  </view>

  <!-- 商品信息 -->
  <view class="card">
    <view class="card-title">商品详情</view>
    <view class="desc">{{product.description || '暂无描述'}}</view>
  </view>

  <!-- 购买数量 -->
  <view class="card">
    <view class="card-title">购买数量（每日配送盒数）</view>
    <view class="qty-row">
      <view class="stepper">
        <view class="stepper-btn" bindtap="decreaseQty">−</view>
        <view class="stepper-num">{{buyQty}}</view>
        <view class="stepper-btn stepper-btn-active" bindtap="increaseQty">＋</view>
      </view>
    </view>
  </view>

  <!-- 底部订购栏 -->
  <view class="footer-bar">
    <view class="footer-cart" bindtap="goCart">
      <view class="cart-icon">🛒</view>
      <view wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</view>
    </view>
    <view class="footer-price">
      <text class="text-price">¥{{product.price}}</text>
      <text class="text-muted footer-unit">/盒</text>
    </view>
    <button class="btn-cart footer-btn" bindtap="addToCart" disabled="{{product.status !== 1}}">加入购物车</button>
    <button class="btn-primary footer-btn" bindtap="goOrder" disabled="{{product.status !== 1}}">
      {{product.status === 1 ? '立即订购' : '已下架'}}
    </button>
  </view>
</view>

<view wx:elif="{{loading}}" class="empty">加载中…</view>
<view wx:else class="empty">奶品不存在或已删除</view>
