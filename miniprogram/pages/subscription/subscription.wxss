.plan {
  padding: 24rpx;
}

.plan-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.plan-status {
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.on {
  color: #67c23a;
  background: #f0f9eb;
}

.off {
  color: #909399;
  background: #f4f4f5;
}

.plan-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #303133;
}

.plan-label {
  color: #909399;
}

.plan-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f5;
}

.mini-btn {
  font-size: 24rpx;
  color: #409eff;
  border: 1rpx solid #409eff;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
}

.mini-danger {
  color: #f56c6c;
  border-color: #f56c6c;
}

.add-btn {
  text-align: center;
  background: #ffffff;
  border: 1rpx dashed #409eff;
  color: #409eff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 40rpx;
}

/* 半屏表单 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.sheet-show {
  transform: translateY(0);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
  text-align: center;
  margin-bottom: 24rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.sheet-label {
  color: #909399;
}

.sheet-picker {
  color: #409eff;
  max-width: 420rpx;
}

.sheet-picker-long {
  font-size: 24rpx;
  max-width: 400rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-input {
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #f0f2f5;
  color: #606266;
}

.sheet-primary {
  background: #409eff;
  color: #ffffff;
}
