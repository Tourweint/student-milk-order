<view class="container">
  <!-- 配送孩子 -->
  <view class="card">
    <view class="card-title">配送信息</view>
    <view class="row">
      <text class="row-label">配送学生</text>
      <text class="row-value">{{student.studentName || '未绑定'}}</text>
    </view>
    <view class="row" wx:if="{{mode !== 'package'}}">
      <text class="row-label">配送日期</text>
      <picker mode="date" value="{{startDate}}" bindchange="onStartChange">
        <view class="picker-value">{{startDate || '请选择'}}</view>
      </picker>
    </view>
    <view class="row" wx:if="{{mode !== 'package'}}">
      <text class="row-label">剩余库存量</text>
      <text class="row-value">{{quotaText}}</text>
    </view>
    <view class="row" wx:if="{{mode !== 'package' && totalBoxes > 0}}">
      <text class="row-label">本次订购</text>
      <text class="row-value">共 {{totalBoxes}} 盒</text>
    </view>
    <view class="row" wx:if="{{mode !== 'package'}}">
      <text class="row-value text-muted">剩余库存按品种分开计算（含近几天未售完的结转），每种奶各自有各自的量；散订按盒数一次性配送，卖完即止</text>
    </view>
    <block wx:if="{{mode === 'package'}}">
      <view class="row">
        <text class="row-label">开始日期</text>
        <text class="row-value">{{startDate}}</text>
      </view>
      <view class="row">
        <text class="row-label">结束日期</text>
        <text class="row-value">{{endDate}}</text>
      </view>
      <view class="row">
        <text class="row-label">配送周期</text>
        <text class="row-value text-muted">{{package && package.packageType === 2 ? '本学期一次性订购（约5个月），不支持自动续订' : '固定一个月，支持自动续订'}}（周期内每日配送）</text>
      </view>
    </block>
  </view>

  <!-- 套餐模式：套餐信息（含固定内容，提交前确认） -->
  <view class="card" wx:if="{{mode === 'package' && package}}">
    <view class="card-title">套餐</view>
    <view class="row">
      <text class="row-label">套餐名称</text>
      <text class="row-value">{{package.packageName}}</text>
    </view>
    <view class="row">
      <text class="row-label">套餐价格</text>
      <text class="row-value text-price">¥{{package.discountPrice || package.originalPrice}}</text>
    </view>
    <view class="row" wx:if="{{package.description}}">
      <text class="row-label">套餐说明</text>
      <text class="row-value">{{package.description}}</text>
    </view>
    <view class="pkg-sec-title">套餐包含（每日配送）</view>
    <view class="pkg-line" wx:for="{{items}}" wx:key="productId">
      <text class="pkg-line-name">{{item.name}}</text>
      <text class="pkg-line-meta">{{item.spec || ''}} · 每日 {{item.quantity}} 盒</text>
    </view>
    <view wx:if="{{!items.length}}" class="pkg-tip">套餐内容未配置，请稍后再试或联系管理员</view>
    <view class="pkg-tip">套餐内容固定不可自选；想喝其他口味可用"散订"单独购买，次日配送</view>
  </view>

  <!-- 明细 -->
  <view class="card" wx:if="{{mode !== 'package'}}">
    <view class="card-title">订购奶品</view>

    <!-- 奶品直购模式：单奶品 stepper（散订按盒数） -->
    <view wx:if="{{mode === 'product' && items.length}}">
      <view class="line-item">
        <view class="line-info">
          <view class="line-name">{{items[0].name}}</view>
          <view class="line-meta">{{items[0].spec || ''}} · ¥{{items[0].price}}/盒</view>
        </view>
        <view class="stepper">
          <view class="stepper-btn" bindtap="decrease" data-index="0">−</view>
          <view class="stepper-num">{{items[0].quantity}}</view>
          <view class="stepper-btn stepper-btn-active" bindtap="increase" data-index="0">＋</view>
        </view>
      </view>
    </view>

    <!-- 购物车模式：多奶品明细（可调整数量） -->
    <view wx:if="{{mode === 'cart' && items.length}}">
      <view class="line-item" wx:for="{{items}}" wx:key="productId">
        <view class="line-info">
          <view class="line-name">{{item.name}}</view>
          <view class="line-meta {{item.quantity > quotaMap[item.productId] ? 'line-insufficient' : ''}}">{{item.spec || ''}} · ¥{{item.price}}/盒 · 剩 {{quotaMap[item.productId] || 0}} 盒</view>
        </view>
        <view class="stepper">
          <view class="stepper-btn" bindtap="decrease" data-index="{{index}}">−</view>
          <view class="stepper-num">{{item.quantity}}</view>
          <view class="stepper-btn stepper-btn-active" bindtap="increase" data-index="{{index}}">＋</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card">
    <view class="card-title">备注（选填）</view>
    <textarea class="remark-input" placeholder="如：过敏原提醒、配送要求等" value="{{remark}}" bindinput="onRemarkInput" maxlength="200" />
  </view>

  <!-- 底部提交栏 -->
  <view class="footer-bar">
    <view class="footer-price">
      <text class="text-price">¥{{total}}</text>
      <text class="text-muted footer-unit">{{mode === 'package' ? '套餐价' : '合计'}}</text>
    </view>
    <button class="btn-primary footer-btn" bindtap="handleSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交并支付</button>
  </view>
</view>
